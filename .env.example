# Copy to .env and replace this development placeholder.
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Safe local default: print mail without sending it.
# Remove this setting to automatically select an API provider below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Shared Counselling <bookings@example.com>
BOOKING_NOTIFY_EMAIL=practice@example.com

# Production: configure one provider and an authorized sender above.
# RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# DATABASE_URL=postgresql://user:password@host:5432/database
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# SMTP alternative:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_TIMEOUT=10
